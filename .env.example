APP_NAME=Dodo Agent Python
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8888
SERVE_FRONTEND=true
CORS_ORIGINS=*

# Chat model (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
CHAT_TEMPERATURE=0.5
MODEL_TIMEOUT_SECONDS=120
AGENT_RECURSION_LIMIT=24

# Embeddings
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Same datasource defaults and override names as the Java application.yml.
# Set MYSQL_PASSWORD locally if the MySQL account requires one.
MYSQL_URL=jdbc:mysql://127.0.0.1:3307/dodo?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Same Redis settings as the Java application.yml.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# File/RAG infrastructure. The Python bucket remains private when created.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=rag-test2
# Java-compatible PGVector fields. PGVECTOR_URL remains an optional legacy override.
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=vector_store
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=
PGVECTOR_URL=
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/
VISION_MODEL=qwen3-vl-plus
MAX_UPLOAD_BYTES=52428800
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
